# --- Required ---------------------------------------------------------------
# OpenAI API key (used for embeddings + chat completions).
OPENAI_API_KEY=sk-...

# Pinecone API key.
PINECONE_API_KEY=...

# Name of your Pinecone index. The host is resolved automatically via
# describeIndex(). The index dimension MUST be 1536 to match
# text-embedding-3-small.
PINECONE_INDEX=kairo-knowledge

# --- GHL SSO auth (required for /session and /generate) ---------------------
# The "SSO / Shared Secret" from your GHL Marketplace app
# (GHL Marketplace -> your app -> Settings -> SSO). Used to AES-decrypt the
# SSO token relayed by the embedded frontend.
GHL_APP_SHARED_SECRET=...

# A long random string you set. Used to sign/verify the session JWT this
# backend issues. Generate with: openssl rand -hex 32
SESSION_JWT_SECRET=...

# OPTIONAL comma-separated allowlist of GHL location (sub-account) IDs allowed
# to use this tool. If unset, any sub-account is allowed.
ALLOWED_LOCATION_IDS=loc_aaa,loc_bbb

# --- CORS --------------------------------------------------------------------
# Origin of the embedded frontend (the static host inside the GHL iframe).
# Falls back to ALLOWED_ORIGIN, then "*" if neither is set.
FRONTEND_ORIGIN=https://your-frontend.example.com

# Legacy CORS origin (still honored as a fallback for FRONTEND_ORIGIN).
ALLOWED_ORIGIN=https://your-frontend.example.com

# --- Misc --------------------------------------------------------------------
# Port. Railway injects this automatically; defaults to 3000 locally.
PORT=3000

# NOTE: APP_SECRET / x-api-key has been RETIRED. /generate is now gated by the
# GHL session JWT (Authorization: Bearer <jwt>), not a shared key.
