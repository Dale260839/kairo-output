# --- Required ---------------------------------------------------------------
# OpenAI API key (used for embeddings + chat completions).
OPENAI_API_KEY=sk-...

# Pinecone API key.
PINECONE_API_KEY=...

# Name of your Pinecone index. The host is resolved automatically via
# describeIndex(). The index dimension MUST be 1536 to match
# text-embedding-3-small.
PINECONE_INDEX=kairo-knowledge

# --- Auth / origin allowlist -------------------------------------------------
# Allowed frontend origin(s) for POST /generate. The browser sends NO
# credential; /generate is secured server-side by an origin allowlist + rate
# limiting. Comma-separated to allow more than one origin. Use scheme + host
# with NO trailing slash, e.g.:
#   https://your-site.netlify.app
#   https://your-site.netlify.app,https://staging--your-site.netlify.app
# Must be set in production for the allowlist to take effect (if unset, the
# check allows any origin). Also used for the CORS config.
FRONTEND_ORIGIN=https://your-site.netlify.app

# Legacy CORS origin (still honored as a fallback for FRONTEND_ORIGIN).
ALLOWED_ORIGIN=https://your-site.netlify.app

# GoHighLevel (LeadConnector) — for Send-to-Email
# GHL_PIT: a Private Integration Token from your GHL sub-account
#   (Settings → Private Integrations) with scopes: contacts.write,
#   conversations.write, conversations/message.write
# GHL_LOCATION_ID: the sub-account (location) ID. Only needed when /send-email
# is actually called.
GHL_PIT=
GHL_LOCATION_ID=

# --- Misc --------------------------------------------------------------------
# Port. Railway injects this automatically; defaults to 3000 locally.
PORT=3000
