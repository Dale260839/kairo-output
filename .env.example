# --- Required ---------------------------------------------------------------
# OpenAI API key (used for embeddings + chat completions).
OPENAI_API_KEY=sk-...

# Pinecone API key.
PINECONE_API_KEY=...

# Name of your Pinecone index. The host is resolved automatically via
# describeIndex(). The index dimension MUST be 1536 to match
# text-embedding-3-small.
PINECONE_INDEX=kairo-knowledge

# --- Auth --------------------------------------------------------------------
# Shared secret required in the x-api-key header on POST /generate.
# The frontend sends header: x-api-key: <this value>.
# If unset, the secret check is skipped (not recommended in production).
APP_SECRET=choose-a-long-random-string

# --- CORS --------------------------------------------------------------------
# Origin of the embedded frontend (your Netlify subdomain inside the GHL
# iframe), e.g. https://your-site.netlify.app. Falls back to ALLOWED_ORIGIN,
# then "*" if neither is set.
FRONTEND_ORIGIN=https://your-site.netlify.app

# Legacy CORS origin (still honored as a fallback for FRONTEND_ORIGIN).
ALLOWED_ORIGIN=https://your-site.netlify.app

# --- Misc --------------------------------------------------------------------
# Port. Railway injects this automatically; defaults to 3000 locally.
PORT=3000
